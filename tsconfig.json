{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun-types",
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "core/**/*.ts",
    "omp/**/*.ts",
    "scripts/calibrate.ts",
    "scripts/relabel.ts"
  ],
  "exclude": [
    "omp/diagnostics.test.ts",
    "omp/ninerouter.ts",
    "node_modules"
  ]
}
